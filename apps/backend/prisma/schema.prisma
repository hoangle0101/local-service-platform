// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  active
  inactive
  banned
}

enum BookingStatus {
  pending
  accepted
  in_progress
  completed
  cancelled
  disputed
}

enum PaymentStatus {
  initiated
  succeeded
  failed
}

enum ProviderVerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum OtpPurpose {
  login
  reset_password
  verify_phone
}

enum TransactionType {
  deposit
  withdrawal
  payment
  fee
  refund
  earning
}

enum PaymentMethod {
  card
  momo
  bank_transfer
  wallet
}

// ============================================
// MODULE 1: USER & AUTH (4 bảng)
// ============================================

model User {
  id           BigInt     @id @default(autoincrement())
  phone        String     @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(active)
  isVerified   Boolean    @default(false) @map("is_verified")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  metadata     Json?      @db.JsonB
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile               UserProfile?
  providerProfile       ProviderProfile?
  wallet                Wallet?
  userRoles             UserRole[]
  addresses             Address[]
  bookingsCustomer      Booking[]        @relation("CustomerBookings")
  bookingsProvider      Booking[]        @relation("ProviderBookings")
  sessions              Session[]
  notifications         Notification[]
  reviewsGiven          Review[]         @relation("ReviewerReviews")
  reviewsReceived       Review[]         @relation("RevieweeReviews")
  disputesRaised        Dispute[]        @relation("DisputeRaisedBy")
  disputesResolved      Dispute[]        @relation("DisputeResolvedBy")
  conversationsCustomer Conversation[]   @relation("CustomerConversations")
  conversationsProvider Conversation[]   @relation("ProviderConversations")
  sentMessages          Message[]
  mediaUploads          Media[]
  auditLogs             AuditLog[]
  favorites             Favorite[]
  bookingOffers         BookingOffer[]

  @@index([email])
  @@index([status])
  @@index([phone, status])
  @@map("users")
}

model UserProfile {
  userId      BigInt                                @id @map("user_id")
  fullName    String?                               @map("full_name") @db.VarChar(200)
  avatarUrl   String?                               @map("avatar_url") @db.Text
  bio         String?                               @db.Text
  gender      String?                               @db.VarChar(20)
  birthDate   DateTime?                             @map("birth_date") @db.Date
  addressText String?                               @map("address_text") @db.Text
  location    Unsupported("geography(Point,4326)")?
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OtpCode {
  id            BigInt     @id @default(autoincrement())
  phone         String     @db.VarChar(20)
  codeHash      String     @map("code_hash") @db.VarChar(255)
  purpose       OtpPurpose
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(6)
  used          Boolean    @default(false)
  attemptCount  Int        @default(0) @map("attempt_count") @db.SmallInt
  lastAttemptAt DateTime?  @map("last_attempt_at") @db.Timestamptz(6)
  ipAddress     String?    @map("ip_address") @db.VarChar(50)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose, used])
  @@map("otp_codes")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ip               String?   @db.VarChar(50)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revoked          Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

// ============================================
// MODULE 2: RBAC (4 bảng)
// ============================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  action      String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// MODULE 3: SERVICE & PROVIDER (5 bảng)
// ============================================

model ProviderProfile {
  userId             BigInt                                @id @map("user_id")
  displayName        String                                @map("display_name") @db.VarChar(200)
  bio                String?                               @db.Text
  skills             Json?                                 @db.JsonB
  ratingAvg          Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                                   @default(0) @map("rating_count")
  isAvailable        Boolean                               @default(true) @map("is_available")
  verificationStatus ProviderVerificationStatus            @default(unverified) @map("verification_status")
  location           Unsupported("geography(Point,4326)")?
  serviceRadiusM     Int                                   @default(5000) @map("service_radius_m")
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]

  @@index([isAvailable])
  @@index([verificationStatus])
  @@map("provider_profiles")
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  slug        String?  @unique @db.VarChar(150)
  description String?  @db.Text
  iconUrl     String?  @map("icon_url") @db.Text
  parentId    Int?     @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryHierarchy")
  services Service[]

  @@map("service_categories")
}

model Service {
  id              Int      @id @default(autoincrement())
  categoryId      Int?     @map("category_id")
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  basePrice       Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  durationMinutes Int?     @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  providerServices ProviderService[]
  bookings         Booking[]

  @@map("services")
}

model ProviderService {
  providerUserId BigInt    @map("provider_user_id")
  serviceId      Int       @map("service_id")
  price          Decimal   @db.Decimal(12, 2)
  currency       String    @default("VND") @db.VarChar(10)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  provider ProviderProfile @relation(fields: [providerUserId], references: [userId], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerUserId, serviceId])
  @@map("provider_services")
}

model Favorite {
  userId     BigInt   @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   BigInt   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@map("favorites")
}

// ============================================
// MODULE 4: BOOKING & LOCATION (3 bảng)
// ============================================

model Address {
  id          BigInt                               @id @default(autoincrement())
  userId      BigInt                               @map("user_id")
  label       String?                              @db.VarChar(100)
  addressText String                               @map("address_text") @db.Text
  location    Unsupported("geography(Point,4326)")
  isDefault   Boolean                              @default(false) @map("is_default")
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Booking {
  id                       BigInt                               @id @default(autoincrement())
  code                     String?                              @unique @db.VarChar(50)
  customerId               BigInt                               @map("customer_id")
  providerId               BigInt?                              @map("provider_id")
  serviceId                Int                                  @map("service_id")
  providerServicePrice     Decimal?                             @map("provider_service_price") @db.Decimal(12, 2)
  status                   BookingStatus                        @default(pending)
  scheduledAt              DateTime                             @map("scheduled_at") @db.Timestamptz(6)
  addressText              String                               @map("address_text") @db.Text
  location                 Unsupported("geography(Point,4326)")
  notes                    String?                              @db.Text
  estimatedDurationMinutes Int?                                 @map("estimated_duration_minutes")
  estimatedPrice           Decimal?                             @map("estimated_price") @db.Decimal(12, 2)
  actualPrice              Decimal?                             @map("actual_price") @db.Decimal(12, 2)
  platformFee              Decimal                              @default(0) @map("platform_fee") @db.Decimal(12, 2)
  providerEarning          Decimal                              @default(0) @map("provider_earning") @db.Decimal(12, 2)
  createdAt                DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime?                            @map("completed_at") @db.Timestamptz(6)
  cancelledAt              DateTime?                            @map("cancelled_at") @db.Timestamptz(6)

  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  providerUser  User?          @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Restrict)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  bookingEvents BookingEvent[]
  payments      Payment[]
  review        Review?
  dispute       Dispute?
  conversations Conversation[]
  bookingOffers BookingOffer[]

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@map("bookings")
}

model BookingOffer {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @map("booking_id")
  providerId BigInt   @map("provider_id")
  price      Decimal? @db.Decimal(12, 2)
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider User    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId])
  @@map("booking_offers")
}

model BookingEvent {
  id             BigInt         @id @default(autoincrement())
  bookingId      BigInt         @map("booking_id")
  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  actorUserId    BigInt?        @map("actor_user_id")
  note           String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("booking_events")
}

// ============================================
// MODULE 5: PAYMENT & WALLET (3 bảng)
// ============================================

model Payment {
  id          BigInt        @id @default(autoincrement())
  bookingId   BigInt?       @map("booking_id")
  amount      Decimal       @db.Decimal(15, 2)
  currency    String        @default("VND") @db.VarChar(10)
  method      PaymentMethod
  gateway     String?       @db.VarChar(100)
  gatewayTxId String        @map("gateway_tx_id") @db.VarChar(200)
  environment String        @default("production") @db.VarChar(20)
  status      PaymentStatus @default(initiated)
  payload     Json?         @db.JsonB
  reconciled  Boolean       @default(false)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  walletTransactions WalletTransaction[]

  @@unique([gateway, gatewayTxId, environment])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Wallet {
  userId      BigInt    @id @map("user_id")
  balance     Decimal   @default(0) @db.Decimal(18, 4)
  currency    String    @default("VND") @db.VarChar(10)
  version     Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id               BigInt            @id @default(autoincrement())
  walletUserId     BigInt            @map("wallet_user_id")
  relatedPaymentId BigInt?           @map("related_payment_id")
  type             TransactionType
  amount           Decimal           @db.Decimal(18, 4)
  balanceAfter     Decimal           @map("balance_after") @db.Decimal(18, 4)
  idempotencyKey   String?           @unique @map("idempotency_key") @db.VarChar(100)
  status           TransactionStatus @default(completed)
  metadata         Json?             @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet  Wallet   @relation(fields: [walletUserId], references: [userId], onDelete: Restrict)
  payment Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@index([walletUserId, createdAt(sort: Desc)])
  @@index([type])
  @@index([relatedPaymentId])
  @@map("wallet_transactions")
}

// ============================================
// MODULE 6: INTERACTION (4 bảng)
// ============================================

model Review {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @unique @map("booking_id")
  reviewerId BigInt   @map("reviewer_id")
  revieweeId BigInt   @map("reviewee_id")
  rating     Int      @db.SmallInt
  title      String?  @db.VarChar(255)
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId, rating])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@index([reviewerId])
  @@map("reviews")
}

model Dispute {
  id                BigInt        @id @default(autoincrement())
  bookingId         BigInt        @unique @map("booking_id")
  raisedBy          BigInt        @map("raised_by")
  reason            String        @db.Text
  status            DisputeStatus @default(open)
  resolution        String?       @db.Text
  resolvedByAdminId BigInt?       @map("resolved_by_admin_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?     @map("resolved_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  raiser     User    @relation("DisputeRaisedBy", fields: [raisedBy], references: [id])
  resolvedBy User?   @relation("DisputeResolvedBy", fields: [resolvedByAdminId], references: [id])

  @@map("disputes")
}

model Conversation {
  id            BigInt    @id @default(autoincrement())
  customerId    BigInt    @map("customer_id")
  providerId    BigInt    @map("provider_id")
  bookingId     BigInt?   @map("booking_id")
  lastMessageId BigInt?   @map("last_message_id")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  unreadCount   Int       @default(0) @map("unread_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  provider User      @relation("ProviderConversations", fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([customerId])
  @@index([providerId])
  @@index([bookingId])
  @@map("conversations")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  senderId       BigInt    @map("sender_id")
  body           String    @db.Text
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// ============================================
// MODULE 7: SYSTEM & UTILITIES (4 bảng)
// ============================================

model Media {
  id         BigInt    @id @default(autoincrement())
  ownerType  String    @map("owner_type") @db.VarChar(50)
  ownerId    BigInt    @map("owner_id")
  url        String    @db.Text
  mimeType   String?   @map("mime_type") @db.VarChar(100)
  size       Int?
  meta       Json?     @db.JsonB
  uploadedBy BigInt?   @map("uploaded_by")
  category   String?   @db.VarChar(50)
  isPublic   Boolean   @default(true) @map("is_public")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@index([ownerType, category])
  @@map("media")
}

model Notification {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  type        String    @db.VarChar(100)
  title       String?   @db.Text
  body        String?   @db.Text
  payload     Json?     @db.JsonB
  isRead      Boolean   @default(false) @map("is_read")
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt?  @map("actor_user_id")
  action      String   @db.VarChar(200)
  objectType  String?  @map("object_type") @db.VarChar(100)
  objectId    BigInt?  @map("object_id")
  detail      Json?    @db.JsonB
  ip          String?  @db.VarChar(50)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([objectType, objectId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Setting {
  key         String   @id @db.VarChar(200)
  value       Json     @db.JsonB
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}
