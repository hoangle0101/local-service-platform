// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  active
  inactive
  banned
}

enum BookingStatus {
  pending
  accepted
  in_progress
  pending_completion
  pending_payment
  completed
  cancelled
  disputed
}

enum PaymentStatus {
  initiated
  succeeded
  failed
}

enum ProviderVerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum DisputeStatus {
  open
  under_review
  awaiting_response
  escalated
  resolved
  closed
  cancelled
}

enum DisputeCategory {
  service_not_completed
  poor_quality
  price_disagreement
  no_show_provider
  no_show_customer
  damage_caused
  unprofessional_behavior
  payment_issue
  other
}

enum DisputeResolutionType {
  full_refund_to_customer
  partial_refund_to_customer
  full_payment_to_provider
  mutual_cancellation
  no_action
}

enum PenaltyType {
  warning
  temporary_ban
  permanent_ban
  fee_deduction
  rating_penalty
}

enum PenaltySeverity {
  low
  medium
  high
  critical
}

enum EvidenceType {
  image
  video
  audio
  document
  screenshot
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum OtpPurpose {
  login
  reset_password
  verify_phone
}

enum TransactionType {
  deposit
  withdrawal
  payment
  fee
  refund
  earning
}

enum PaymentMethod {
  cod
  card
  momo
  bank_transfer
  wallet
}

// ============================================
// MODULE 1: USER & AUTH (4 bảng)
// ============================================

model User {
  id           BigInt     @id @default(autoincrement())
  phone        String     @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(active)
  isVerified   Boolean    @default(false) @map("is_verified")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  metadata     Json?      @db.JsonB
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile               UserProfile?
  providerProfile       ProviderProfile?
  wallet                Wallet?
  userRoles             UserRole[]
  addresses             Address[]
  bookingsCustomer      Booking[]         @relation("CustomerBookings")
  bookingsProvider      Booking[]         @relation("ProviderBookings")
  sessions              Session[]
  notifications         Notification[]
  reviewsGiven          Review[]          @relation("ReviewerReviews")
  reviewsReceived       Review[]          @relation("RevieweeReviews")
  disputesRaised        Dispute[]         @relation("DisputeRaisedBy")
  disputesResolved      Dispute[]         @relation("DisputeResolvedBy")
  conversationsCustomer Conversation[]    @relation("CustomerConversations")
  conversationsProvider Conversation[]    @relation("ProviderConversations")
  sentMessages          Message[]
  mediaUploads          Media[]
  auditLogs             AuditLog[]
  favorites             Favorite[]
  bookingOffers         BookingOffer[]
  serviceQuotes         ServiceQuote[]    @relation("ProviderQuotes")
  customerPayments      BookingPayment[]  @relation("CustomerPayments")
  providerPayments      BookingPayment[]  @relation("ProviderPayments")
  providerWithdrawals   Withdrawal[]      @relation("ProviderWithdrawals")
  adminWithdrawals      Withdrawal[]      @relation("AdminWithdrawals")
  disputeTimelines      DisputeTimeline[]
  disputeEvidences      DisputeEvidence[]
  penaltiesReceived     Penalty[]         @relation("UserPenalties")
  penaltiesCreated      Penalty[]         @relation("PenaltyCreatedBy")

  @@index([email])
  @@index([status])
  @@index([phone, status])
  @@map("users")
}

model UserProfile {
  userId      BigInt                                @id @map("user_id")
  fullName    String?                               @map("full_name") @db.VarChar(200)
  avatarUrl   String?                               @map("avatar_url") @db.Text
  bio         String?                               @db.Text
  gender      String?                               @db.VarChar(20)
  birthDate   DateTime?                             @map("birth_date") @db.Date
  addressText String?                               @map("address_text") @db.Text
  location    Unsupported("geography(Point,4326)")?
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OtpCode {
  id            BigInt     @id @default(autoincrement())
  phone         String     @db.VarChar(20)
  codeHash      String     @map("code_hash") @db.VarChar(255)
  purpose       OtpPurpose
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(6)
  used          Boolean    @default(false)
  attemptCount  Int        @default(0) @map("attempt_count") @db.SmallInt
  lastAttemptAt DateTime?  @map("last_attempt_at") @db.Timestamptz(6)
  ipAddress     String?    @map("ip_address") @db.VarChar(50)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose, used])
  @@map("otp_codes")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ip               String?   @db.VarChar(50)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revoked          Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

// ============================================
// MODULE 2: RBAC (4 bảng)
// ============================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  action      String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// MODULE 3: SERVICE & PROVIDER (5 bảng)
// ============================================

model ProviderProfile {
  userId             BigInt                                @id @map("user_id")
  displayName        String                                @map("display_name") @db.VarChar(200)
  bio                String?                               @db.Text
  skills             Json?                                 @db.JsonB
  ratingAvg          Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                                   @default(0) @map("rating_count")
  isAvailable        Boolean                               @default(true) @map("is_available")
  verificationStatus ProviderVerificationStatus            @default(unverified) @map("verification_status")
  location           Unsupported("geography(Point,4326)")?
  address            String?                               @db.Text
  latitude           Float?
  longitude          Float?
  serviceRadiusM     Int                                   @default(5000) @map("service_radius_m")
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]

  @@index([isAvailable])
  @@index([verificationStatus])
  @@map("provider_profiles")
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  slug        String?  @unique @db.VarChar(150)
  description String?  @db.Text
  iconUrl     String?  @map("icon_url") @db.Text
  parentId    Int?     @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("CategoryHierarchy")
  services Service[]

  @@map("service_categories")
}

model Service {
  id              Int      @id @default(autoincrement())
  categoryId      Int?     @map("category_id")
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  basePrice       Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  durationMinutes Int?     @map("duration_minutes")
  imageUrl        String?  @map("image_url") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  providerServices ProviderService[]
  bookings         Booking[]

  @@map("services")
}

model ProviderService {
  providerUserId BigInt    @map("provider_user_id")
  serviceId      Int       @map("service_id")
  price          Decimal   @db.Decimal(12, 2)
  currency       String    @default("VND") @db.VarChar(10)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  provider ProviderProfile @relation(fields: [providerUserId], references: [userId], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerUserId, serviceId])
  @@map("provider_services")
}

model Favorite {
  userId     BigInt   @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   BigInt   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@map("favorites")
}

// ============================================
// MODULE 4: BOOKING & LOCATION (3 bảng)
// ============================================

model Address {
  id          BigInt                               @id @default(autoincrement())
  userId      BigInt                               @map("user_id")
  label       String?                              @db.VarChar(100)
  addressText String                               @map("address_text") @db.Text
  location    Unsupported("geography(Point,4326)")
  isDefault   Boolean                              @default(false) @map("is_default")
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Booking {
  id                       BigInt                               @id @default(autoincrement())
  code                     String?                              @unique @db.VarChar(50)
  customerId               BigInt                               @map("customer_id")
  providerId               BigInt?                              @map("provider_id")
  serviceId                Int                                  @map("service_id")
  providerServicePrice     Decimal?                             @map("provider_service_price") @db.Decimal(12, 2)
  status                   BookingStatus                        @default(pending)
  scheduledAt              DateTime                             @map("scheduled_at") @db.Timestamptz(6)
  addressText              String                               @map("address_text") @db.Text
  location                 Unsupported("geography(Point,4326)")
  notes                    String?                              @db.Text
  estimatedDurationMinutes Int?                                 @map("estimated_duration_minutes")
  estimatedPrice           Decimal?                             @map("estimated_price") @db.Decimal(12, 2)
  actualPrice              Decimal?                             @map("actual_price") @db.Decimal(12, 2)
  additionalCosts          Decimal?                             @map("additional_costs") @db.Decimal(12, 2)
  additionalNotes          String?                              @map("additional_notes") @db.Text
  platformFee              Decimal                              @default(0) @map("platform_fee") @db.Decimal(12, 2)
  providerEarning          Decimal                              @default(0) @map("provider_earning") @db.Decimal(12, 2)
  paymentMethod            PaymentMethod?                       @map("payment_method")
  paymentStatus            String                               @default("unpaid") @map("payment_status") @db.VarChar(20)
  createdAt                DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime?                            @map("completed_at") @db.Timestamptz(6)
  cancelledAt              DateTime?                            @map("cancelled_at") @db.Timestamptz(6)
  paidAt                   DateTime?                            @map("paid_at") @db.Timestamptz(6)

  customer       User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  providerUser   User?           @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Restrict)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  bookingEvents  BookingEvent[]
  payments       Payment[]
  review         Review?
  dispute        Dispute?
  conversations  Conversation[]
  bookingOffers  BookingOffer[]
  serviceQuotes  ServiceQuote[]
  bookingPayment BookingPayment?

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@map("bookings")
}

model BookingOffer {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @map("booking_id")
  providerId BigInt   @map("provider_id")
  price      Decimal? @db.Decimal(12, 2)
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider User    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId])
  @@map("booking_offers")
}

model BookingEvent {
  id             BigInt         @id @default(autoincrement())
  bookingId      BigInt         @map("booking_id")
  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  actorUserId    BigInt?        @map("actor_user_id")
  note           String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("booking_events")
}

// ============================================
// MODULE 5: PAYMENT & WALLET (3 bảng)
// ============================================

model Payment {
  id          BigInt        @id @default(autoincrement())
  bookingId   BigInt?       @map("booking_id")
  amount      Decimal       @db.Decimal(15, 2)
  currency    String        @default("VND") @db.VarChar(10)
  method      PaymentMethod
  gateway     String?       @db.VarChar(100)
  gatewayTxId String        @map("gateway_tx_id") @db.VarChar(200)
  environment String        @default("production") @db.VarChar(20)
  status      PaymentStatus @default(initiated)
  payload     Json?         @db.JsonB
  reconciled  Boolean       @default(false)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  walletTransactions WalletTransaction[]

  @@unique([gateway, gatewayTxId, environment])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Wallet {
  userId      BigInt    @id @map("user_id")
  balance     Decimal   @default(0) @db.Decimal(18, 4)
  currency    String    @default("VND") @db.VarChar(10)
  version     Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id               BigInt            @id @default(autoincrement())
  walletUserId     BigInt            @map("wallet_user_id")
  relatedPaymentId BigInt?           @map("related_payment_id")
  type             TransactionType
  amount           Decimal           @db.Decimal(18, 4)
  balanceAfter     Decimal           @map("balance_after") @db.Decimal(18, 4)
  idempotencyKey   String?           @unique @map("idempotency_key") @db.VarChar(100)
  status           TransactionStatus @default(completed)
  metadata         Json?             @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet  Wallet   @relation(fields: [walletUserId], references: [userId], onDelete: Restrict)
  payment Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@index([walletUserId, createdAt(sort: Desc)])
  @@index([type])
  @@index([relatedPaymentId])
  @@map("wallet_transactions")
}

// ============================================
// MODULE 6: INTERACTION (4 bảng)
// ============================================

model Review {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @unique @map("booking_id")
  reviewerId BigInt   @map("reviewer_id")
  revieweeId BigInt   @map("reviewee_id")
  rating     Int      @db.SmallInt
  title      String?  @db.VarChar(255)
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId, rating])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@index([reviewerId])
  @@map("reviews")
}

model Dispute {
  id                BigInt                 @id @default(autoincrement())
  bookingId         BigInt                 @unique @map("booking_id")
  raisedBy          BigInt                 @map("raised_by")
  category          DisputeCategory        @default(other)
  reason            String                 @db.Text
  status            DisputeStatus          @default(open)
  resolutionType    DisputeResolutionType? @map("resolution_type")
  resolution        String?                @db.Text
  refundAmount      Decimal?               @map("refund_amount") @db.Decimal(15, 2)
  adminNotes        String?                @map("admin_notes") @db.Text
  resolvedByAdminId BigInt?                @map("resolved_by_admin_id")
  escalatedAt       DateTime?              @map("escalated_at") @db.Timestamptz(6)
  respondedAt       DateTime?              @map("responded_at") @db.Timestamptz(6)
  appealCount       Int                    @default(0) @map("appeal_count")
  lastAppealAt      DateTime?              @map("last_appeal_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?              @map("resolved_at") @db.Timestamptz(6)

  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  raiser     User              @relation("DisputeRaisedBy", fields: [raisedBy], references: [id])
  resolvedBy User?             @relation("DisputeResolvedBy", fields: [resolvedByAdminId], references: [id])
  timeline   DisputeTimeline[]
  evidence   DisputeEvidence[]
  penalties  Penalty[]

  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("disputes")
}

// Dispute timeline for tracking all actions
model DisputeTimeline {
  id          BigInt   @id @default(autoincrement())
  disputeId   BigInt   @map("dispute_id")
  action      String   @db.VarChar(50)
  description String   @db.Text
  actorUserId BigInt?  @map("actor_user_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id])

  @@index([disputeId])
  @@map("dispute_timeline")
}

// Evidence/attachments for disputes
model DisputeEvidence {
  id          BigInt       @id @default(autoincrement())
  disputeId   BigInt       @map("dispute_id")
  uploaderId  BigInt       @map("uploader_id")
  type        EvidenceType
  url         String       @db.VarChar(500)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute  Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([disputeId])
  @@map("dispute_evidence")
}

// Penalty system
model Penalty {
  id               BigInt          @id @default(autoincrement())
  userId           BigInt          @map("user_id")
  disputeId        BigInt?         @map("dispute_id")
  type             PenaltyType
  severity         PenaltySeverity
  reason           String          @db.Text
  amount           Decimal?        @db.Decimal(15, 2)
  expiresAt        DateTime?       @map("expires_at") @db.Timestamptz(6)
  isActive         Boolean         @default(true) @map("is_active")
  createdByAdminId BigInt          @map("created_by_admin_id")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation("UserPenalties", fields: [userId], references: [id])
  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  createdBy User     @relation("PenaltyCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([userId])
  @@index([disputeId])
  @@index([isActive])
  @@map("penalties")
}

model Conversation {
  id            BigInt    @id @default(autoincrement())
  customerId    BigInt    @map("customer_id")
  providerId    BigInt    @map("provider_id")
  bookingId     BigInt?   @map("booking_id")
  lastMessageId BigInt?   @map("last_message_id")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  unreadCount   Int       @default(0) @map("unread_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  provider User      @relation("ProviderConversations", fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([customerId])
  @@index([providerId])
  @@index([bookingId])
  @@map("conversations")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  senderId       BigInt    @map("sender_id")
  body           String    @db.Text
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// ============================================
// MODULE 7: SYSTEM & UTILITIES (4 bảng)
// ============================================

model Media {
  id         BigInt    @id @default(autoincrement())
  ownerType  String    @map("owner_type") @db.VarChar(50)
  ownerId    BigInt    @map("owner_id")
  url        String    @db.Text
  mimeType   String?   @map("mime_type") @db.VarChar(100)
  size       Int?
  meta       Json?     @db.JsonB
  uploadedBy BigInt?   @map("uploaded_by")
  category   String?   @db.VarChar(50)
  isPublic   Boolean   @default(true) @map("is_public")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@index([ownerType, category])
  @@map("media")
}

model Notification {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  type        String    @db.VarChar(100)
  title       String?   @db.Text
  body        String?   @db.Text
  payload     Json?     @db.JsonB
  isRead      Boolean   @default(false) @map("is_read")
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt?  @map("actor_user_id")
  action      String   @db.VarChar(200)
  objectType  String?  @map("object_type") @db.VarChar(100)
  objectId    BigInt?  @map("object_id")
  detail      Json?    @db.JsonB
  ip          String?  @db.VarChar(50)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([objectType, objectId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Setting {
  key         String   @id @db.VarChar(200)
  value       Json     @db.JsonB
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// ============================================
// MODULE 9: PAYMENT SYSTEM (3 bảng mới)
// ============================================

enum QuoteStatus {
  pending
  accepted
  rejected
  expired
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum BookingPaymentStatus {
  pending // Chờ thanh toán
  held // Đã giữ trong escrow
  released // Đã chuyển cho provider
  refunded // Đã hoàn tiền
  disputed // Đang tranh chấp
}

// Báo giá cho dịch vụ sửa chữa (giá biến đổi)
model ServiceQuote {
  id         BigInt @id @default(autoincrement())
  bookingId  BigInt @map("booking_id")
  providerId BigInt @map("provider_id")

  diagnosis   String  @db.Text // Mô tả lỗi
  items       Json    @db.JsonB // [{name, price, qty}]
  laborCost   Decimal @map("labor_cost") @db.Decimal(18, 2) // Công sửa
  partsCost   Decimal @map("parts_cost") @db.Decimal(18, 2) // Linh kiện
  totalCost   Decimal @map("total_cost") @db.Decimal(18, 2) // Tổng
  platformFee Decimal @map("platform_fee") @db.Decimal(18, 2) // 10%
  finalPrice  Decimal @map("final_price") @db.Decimal(18, 2) // Khách trả

  warranty      String?  @db.VarChar(100) // Bảo hành
  estimatedTime Int?     @map("estimated_time") // Phút
  images        String[] @db.VarChar(500) // URL ảnh hư hỏng
  notes         String?  @db.Text

  status     QuoteStatus @default(pending)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6) // Hết hạn 24h
  acceptedAt DateTime?   @map("accepted_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider User    @relation("ProviderQuotes", fields: [providerId], references: [id])

  @@index([bookingId])
  @@index([providerId])
  @@index([status])
  @@map("service_quotes")
}

// Theo dõi thanh toán booking với escrow
model BookingPayment {
  id         BigInt @id @default(autoincrement())
  bookingId  BigInt @unique @map("booking_id")
  customerId BigInt @map("customer_id")
  providerId BigInt @map("provider_id")

  amount         Decimal @db.Decimal(18, 2) // Tổng tiền khách trả
  platformFee    Decimal @map("platform_fee") @db.Decimal(18, 2) // 10%
  providerAmount Decimal @map("provider_amount") @db.Decimal(18, 2) // 90%

  paymentMethod String  @map("payment_method") @db.VarChar(20) // COD, MOMO
  momoTransId   String? @map("momo_trans_id") @db.VarChar(100)

  status     BookingPaymentStatus @default(pending)
  paidAt     DateTime?            @map("paid_at") @db.Timestamptz(6)
  heldAt     DateTime?            @map("held_at") @db.Timestamptz(6)
  releasedAt DateTime?            @map("released_at") @db.Timestamptz(6)
  refundedAt DateTime?            @map("refunded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerPayments", fields: [customerId], references: [id])
  provider User    @relation("ProviderPayments", fields: [providerId], references: [id])

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("booking_payments")
}

// Rút tiền của Provider
model Withdrawal {
  id         BigInt @id @default(autoincrement())
  providerId BigInt @map("provider_id")

  amount    Decimal @db.Decimal(18, 2) // Số tiền rút
  fee       Decimal @default(0) @db.Decimal(18, 2) // Phí rút
  netAmount Decimal @map("net_amount") @db.Decimal(18, 2) // Thực nhận

  method      String  @db.VarChar(20) // BANK, MOMO
  bankName    String? @map("bank_name") @db.VarChar(100)
  bankAccount String? @map("bank_account") @db.VarChar(50)
  bankHolder  String? @map("bank_holder") @db.VarChar(100)
  momoPhone   String? @map("momo_phone") @db.VarChar(20)

  status      WithdrawalStatus @default(pending)
  note        String?          @db.Text
  adminNote   String?          @map("admin_note") @db.Text
  processedBy BigInt?          @map("processed_by")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  provider User  @relation("ProviderWithdrawals", fields: [providerId], references: [id])
  admin    User? @relation("AdminWithdrawals", fields: [processedBy], references: [id])

  @@index([providerId])
  @@index([status])
  @@map("withdrawals")
}

// Giá sàn cho từng loại dịch vụ (Platform quyết định)
model MinimumPrice {
  id           BigInt   @id @default(autoincrement())
  categoryCode String   @map("category_code") @db.VarChar(50)
  categoryName String   @map("category_name") @db.VarChar(100)
  minPrice     Decimal  @map("min_price") @db.Decimal(18, 2)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([categoryCode])
  @@map("minimum_prices")
}
